# Copy to .env and fill in. Lab Panorama only. Do NOT point this at production.
PANORAMA_HOST=
PANORAMA_PORT=443
PANORAMA_API_KEY=

# The tool refuses to run unless PANORAMA_HOST is listed here (read from .env only).
ALLOWED_HOSTS=

# rest (default): uses the REST API - inventory by device group/template stack, and security rules.
# xml: uses the XML API - adds connectivity, HA, sync, jobs and logs (needs XML API role access).
API_MODE=rest
# Your Panorama's version, as in https://<panorama>/restapi/v11.0/...
REST_VERSION=v11.0
# Optional: comma-separated device-group names, used if Panorama/DeviceGroups can't be read.
DEVICE_GROUPS=

# TLS: lab Panorama usually has a self-signed cert. To verify it, set VERIFY_TLS=true
# and point CA_BUNDLE at the Panorama/corp CA certificate (PEM).
VERIFY_TLS=false
CA_BUNDLE=

# Ignore HTTP(S)_PROXY env vars and connect straight to Panorama.
BYPASS_PROXY=true
# XML API only: send the key in the X-PAN-KEY header (true) or the POST body (false).
# The key is never put in a URL.
KEY_IN_HEADER=true
HTTP_METHOD=POST

# Load control
REQUEST_DELAY_SEC=1
TIMEOUT_SEC=60
LOG_WINDOW_HOURS=24
MAX_LOGS=100
MAX_JOBS=50

# Per-firewall queries proxied through Panorama (target=<serial>). Off by default.
ENABLE_TARGETED=false
MAX_TARGETED_FIREWALLS=5

OUTPUT_DIR=reports
